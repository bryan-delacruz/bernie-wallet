# Bernie Wallet — variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NO subir .env.local al repositorio.

# --- App ---
# URL pública del sitio. En local: http://localhost:3000
# En producción: tu dominio HTTPS (necesario para OG al compartir e instalar la PWA).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (cliente + servidor) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google OAuth (servidor) — para refrescar el access token de Gmail ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Claude API (servidor) — Parser de extracción ---
ANTHROPIC_API_KEY=

# --- Sync (opcional) ---
# Máximo de correos a parsear por sincronización. Default 100.
# SYNC_MAX_RESULTS=100
# Días que cubre la PRIMERA sincronización (sin cursor previo). Default 30.
# Súbelo para hacer backfill de correos antiguos (ej. 180). Luego avanza por cursor.
# SYNC_INITIAL_DAYS=30
# Modo descubrimiento (pruebas): audita correos del banco no capturados por los
# filtros y los registra en la tabla sync_discoveries. Apagar en producción.
# SYNC_DISCOVERY=true

# --- Cifrado del refresh token de Gmail (servidor) ---
# Clave AES-256-GCM: 32 bytes en base64.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
