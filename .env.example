# Bernie Wallet — variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NO subir .env.local al repositorio.

# --- App ---
# URL pública del sitio. En local: http://localhost:3000
# En producción: tu dominio HTTPS (necesario para OG al compartir e instalar la PWA).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (cliente + servidor) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google OAuth (servidor) — para refrescar el access token de Gmail ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sync (opcional) ---
# Máximo de correos a procesar por sincronización. Default 100.
# La 1ª vez cubre los últimos 30 días (hasta este tope); luego, desde el cursor.
# El parser es programático (regex), sin IA: no requiere ninguna API key.
# SYNC_MAX_RESULTS=100

# --- Cifrado del refresh token de Gmail (servidor) ---
# Clave AES-256-GCM: 32 bytes en base64.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
