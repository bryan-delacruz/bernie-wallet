# Bernie Wallet — variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NO subir .env.local al repositorio.

# --- Supabase (cliente + servidor) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google OAuth (servidor) — para refrescar el access token de Gmail ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Claude API (servidor) — Parser de extracción ---
ANTHROPIC_API_KEY=

# --- Sync (opcional) ---
# Máximo de correos por sincronización. Default 10 (pruebas). Producción: 100.
# SYNC_MAX_RESULTS=100

# --- Cifrado del refresh token de Gmail (servidor) ---
# Clave AES-256-GCM: 32 bytes en base64.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
